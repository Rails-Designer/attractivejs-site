<!DOCTYPE html>
<html class="scroll-smooth">
  <head>
    <%= meta_tags %>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= yield :head %>

    <%= render partial: "shared/favicons" %>

    <%= stylesheet_link_tag :app %>
    <script defer src="https://cdn.jsdelivr.net/npm/attractivejs@0.12.0"></script>
  </head>

  <body class="selection:text-gray-700 selection:bg-gray-400/50">
    <%= yield %>

    <%= link_to "Hosted on Seal Static", "https://sealstatic.com", rel: :nofollow, target: :blank, class: "inline-flex fixed right-4 bottom-4 px-2 py-1 text-xs text-gray-600 font-medium tracking-tight bg-white border border-gray-200/50 rounded-md transition hover:border-gray-200" %>
  </body>
</html>
